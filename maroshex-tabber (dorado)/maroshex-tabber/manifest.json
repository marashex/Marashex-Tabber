{
  "manifest_version": 3,
  "name": "maroshex tabber",
  "version": "1.0",
  "description": "tagging in tides",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.sharepoint.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.office.com/*",
    "https://outlook.live.com/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "maroshex tabber"
  },
  "icons": {
    "128": "icon128.png"
  }
}